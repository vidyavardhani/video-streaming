<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create your account</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <main class="container">
    <section class="card" style="max-width: 480px; margin: 4rem auto;">
      <h1>Create your account</h1>
      <p style="color: var(--muted); margin-bottom: 1.5rem;">Teachers can run live classes, students can join instantly.</p>
      <div id="form-error" class="error-box hidden"></div>
      <form id="register-form">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" required placeholder="Alex Morgan">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="alex@example.com">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" minlength="6" required placeholder="Minimum 6 characters">
        <label for="role">Role</label>
        <select id="role" name="role" required>
          <option value="teacher">Teacher</option>
          <option value="student">Student</option>
        </select>
        <label for="institute">Institute/School (optional)</label>
        <input type="text" id="institute" name="institute" placeholder="e.g. Harvard University">
        <label for="location">Location (optional)</label>
        <input type="text" id="location" name="location" placeholder="e.g. Boston, MA">
        <button type="submit" class="primary">Create account</button>
      </form>
      <p style="margin-top: 1.5rem; color: var(--muted);">
        Already registered? <a href="/">Sign in</a>
      </p>
    </section>
  </main>
  <script src="/public/js/auth.js" defer></script>
</body>
</html>
