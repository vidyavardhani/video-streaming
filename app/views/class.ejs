<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Live Class</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div
    id="class-app"
    data-class-code="<%= classCode %>"
    data-role="<%= roleHint || '' %>"
    data-host-token="<%= hostToken || '' %>"
    data-prefill-name="<%= prefillName || '' %>"
    data-code-token="<%= codeToken || '' %>"
  >
    <section id="join-view">
      <div class="join-layout">
        <div class="join-card">
          <header class="join-header">
            <div>
              <p class="pill">Upcoming class</p>
              <h1 id="meeting-title">Live Class</h1>
            </div>
            <div class="meeting-actions">
              <button id="copy-link" class="ghost" data-link="">Copy link</button>
              <button id="copy-code" class="ghost" data-code="">Copy code</button>
            </div>
          </header>
          <div class="meeting-code-card">
            <span class="label">Meeting code</span>
            <strong id="meeting-code">—</strong>
          </div>
          <div class="preview-video-wrapper">
            <video id="preview-video" autoplay muted playsinline></video>
          </div>
          <label for="display-name" class="field-label">Your name</label>
          <input id="display-name" type="text" placeholder="Enter your name" class="text-input">
          <div class="preview-controls">
            <button class="ghost pill-btn" id="toggle-mic">Mute preview</button>
            <button class="ghost pill-btn" id="toggle-camera" aria-haspopup="true" aria-expanded="false">Hide camera</button>
            <button class="primary" id="join-btn">Join class</button>
          </div>
        </div>
      </div>
    </section>

    <section id="lobby-view" class="hidden">
      <div class="status-card">
        <div class="status-indicator waiting"></div>
        <h2>Waiting room</h2>
        <p id="waiting-message">Waiting for the host to let you in…</p>
      </div>
    </section>

    <section id="host-lobby" class="hidden">
      <div class="host-lobby-card">
        <header>
          <div>
            <h2>Lobby</h2>
            <p>Review requests before starting.</p>
          </div>
          <button id="start-btn" class="primary">Start class</button>
        </header>
        <ul id="lobby-list" class="lobby-list"></ul>
      </div>
    </section>

    <section id="live-view" class="hidden">
      <div class="meeting-shell">
        <header class="meeting-header">
          <button id="quick-fullscreen" class="quick-fullscreen-btn" type="button" aria-label="Toggle fullscreen" title="Toggle fullscreen (F11)">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="meeting-heading">
            <span class="meeting-context">VVD Live Session</span>
            <h2 id="live-meeting-title">Live class</h2>
          </div>
          <div class="header-meta">
            <div class="meeting-meters">
              <span id="meter-meeting" class="meter-chip" aria-label="Meeting elapsed" title="Meeting elapsed">⏱ <span id="meter-meeting-time">00:00:00</span></span>
              <span id="meter-recording" class="meter-chip hidden" aria-label="Recording elapsed" title="Recording elapsed">
                <span class="dot" aria-hidden="true"></span>
                REC <span id="meter-recording-time">00:00:00</span>
              </span>
            </div>
            <button class="header-btn" id="share-info" type="button" aria-label="Copy invite link" data-tooltip="Copy invite link">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M12.5 7.5h4a3 3 0 0 1 0 6h-1.25" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M11.5 16.5h-4a3 3 0 1 1 0-6H8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M9 12h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                </svg>
              </span>
            </button>
            <button class="header-btn host-only" id="email-invite" type="button" aria-label="Invite via email" data-tooltip="Invite via email">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M4.5 5.5h15a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17V7a1.5 1.5 0 0 1 1.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                  <path d="M5 7l7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </button>
         
            <span class="status-chip live">
              <span class="dot"></span>
              Live
            </span>
          </div>
        </header>
        
        <!-- Mobile Menu Button (VVD Logo) -->
        <button id="mobile-menu-btn" class="mobile-menu-btn" type="button" aria-label="Open menu" aria-haspopup="true" aria-expanded="false">
          <img src="https://vvdlive.com/logo.svg" alt="VVD Live" width="120" height="120">
        </button>
        <div class="stage">
          <div class="stage-main" id="stage-main">
            <video id="primary-video" autoplay playsinline></video>
            <!-- <div class="stage-live-watermark"><img src="https://vvdlive.com/logo.svg" width="154" alt="Live watermark"></div> -->
            <div class="stage-overlay">
              <span id="primary-label">Connecting…</span>
            </div>
            <canvas id="whiteboard-canvas" class="whiteboard hidden" width="960" height="540"></canvas>
            <div id="speaker-banner" class="speaker-banner hidden"></div>
          </div>
          <div id="pip-container" class="stage-pip hidden">
            <video id="pip-video" autoplay muted playsinline></video>
            <span id="pip-label"></span>
          </div>
          <div id="participant-strip" class="participant-strip"></div>
        </div>
        <div id="chat-overlay" class="chat-overlay hidden" aria-hidden="true">
          <div class="chat-overlay-backdrop" data-dismiss="chat"></div>
          <div id="chat-drawer" class="chat-overlay-panel" role="dialog" aria-modal="true" aria-labelledby="chat-title">
            <div class="drawer-header">
              <h3 id="chat-title">Class chat</h3>
              <button id="chat-close" class="ghost small" type="button">Close</button>
            </div>
            <div id="chat-messages" class="chat-messages"></div>
            <form id="chat-form" class="chat-form">
              <input id="chat-text" type="text" placeholder="Send a message" autocomplete="off">
              <button type="submit" class="chat-send" aria-label="Send message">
                <span>Send</span>
              </button>
            </form>
          </div>
        </div>
        <div id="participants-drawer" class="side-drawer hidden" aria-hidden="true">
          <div class="drawer-header">
            <h3>Participants</h3>
            <button id="participants-close" class="ghost small" type="button">Close</button>
          </div>
          <section id="live-lobby-card" class="lobby-card hidden">
            <header>
              <h4>Waiting to join</h4>
              <span id="live-lobby-count" class="badge">0</span>
            </header>
            <ul id="live-lobby-list"></ul>
          </section>
          <ul id="participants-list" class="participants"></ul>
          <div id="auto-join-panel" class="auto-join-panel" data-class-code="<%= classCode %>"></div>
          <div id="raised-hands" class="raised-hands hidden">
            <h4>Hands raised</h4>
            <ul id="raised-hands-list"></ul>
          </div>
        </div>
        <div id="drawer-backdrop" class="drawer-backdrop hidden" aria-hidden="true"></div>
        
        <!-- Mobile Controls Menu -->
        <div id="mobile-controls-menu" class="mobile-controls-menu hidden" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title">
          <div class="mobile-menu-header">
            <h3 id="mobile-menu-title">Controls</h3>
            <button id="mobile-menu-close" class="ghost small" type="button">Close</button>
          </div>
          <div class="mobile-menu-grid" id="mobile-menu-grid">
            <!-- Controls will be cloned here dynamically -->
          </div>
        </div>
        <div id="mobile-menu-backdrop" class="mobile-menu-backdrop hidden" aria-hidden="true"></div>
   
        <div id="utility-panel" class="utility-panel hidden">
          <div class="utility-header">
            <div>
              <h3>Class tools</h3>
              <p>Whiteboard, polls, Q&amp;A &amp; recording</p>
            </div>
            <button id="utility-close" class="ghost small">Close</button>
          </div>
          <div class="utility-tabs">
            <button class="utility-tab active" data-tab="whiteboard">Whiteboard</button>
            <button class="utility-tab" data-tab="polls">Polls</button>
            <button class="utility-tab" data-tab="qna">Q&amp;A</button>
            <button class="utility-tab" data-tab="recording">Recording</button>
          </div>
          <div class="utility-content">
            <section class="utility-pane" data-pane="whiteboard">
              <div class="whiteboard-toolbar">
                <span>Draw in real-time.</span>
                <div>
                  <input type="color" id="whiteboard-color" value="#1e3a8a">
                  <input type="range" id="whiteboard-size" min="2" max="12" value="4">
                  <button id="whiteboard-clear" class="ghost small">Clear</button>
                </div>
              </div>
              <div class="whiteboard-info">Host drawings sync live. Students view only.</div>
            </section>
            <section class="utility-pane hidden" data-pane="polls">
              <div id="polls-wrapper">
                <form id="poll-create-form" class="panel-card hidden">
                  <label for="poll-question">Question</label>
                  <input id="poll-question" type="text" placeholder="Ask a question">
                  <label for="poll-options">Options (one per line)</label>
                  <textarea id="poll-options" rows="4" placeholder="Option A&#10;Option B"></textarea>
                  <button type="submit" class="primary small">Launch poll</button>
                </form>
                <div id="poll-active" class="panel-card hidden">
                  <header>
                    <h4 id="poll-active-question">Poll</h4>
                    <button id="poll-close" class="ghost small hidden">End poll</button>
                  </header>
                  <ul id="poll-options-list"></ul>
                </div>
                <div id="poll-history" class="panel-card hidden">
                  <h4>Previous polls</h4>
                  <ul id="poll-history-list"></ul>
                </div>
              </div>
            </section>
            <section class="utility-pane hidden" data-pane="qna">
              <form id="qna-form" class="panel-card">
                <label for="qna-input">Ask the host</label>
                <input id="qna-input" type="text" placeholder="Type your question" autocomplete="off">
              </form>
              <div class="panel-card">
                <h4>Questions</h4>
                <ul id="qna-list"></ul>
              </div>
            </section>
            <section class="utility-pane hidden" data-pane="recording">
              <div class="panel-card">
                <div id="recording-status" class="recording-status">Recording inactive</div>
                <div class="recording-meta">
                  <span id="meeting-start-time" class="muted">—</span>
                  <span id="recording-timer" class="recording-timer hidden">00:00:00</span>
                </div>
                <div class="recording-actions">
                  <button id="recording-start" class="primary small">Start recording</button>
                  <button id="recording-pause" class="ghost small">Pause recording</button>
                  <button id="recording-stop" class="ghost small">Stop recording</button>
                </div>
                <div id="recording-link" class="recording-link hidden"></div>
              </div>
            </section>
          </div>
        </div>
        <footer class="meeting-controls">
          <div class="control-bar">
            <div class="control-dock" id="control-dock">
              <button id="live-mic-toggle" class="control-btn host-only" type="button" aria-label="Toggle microphone" aria-pressed="true" data-tooltip="Mic">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <path d="M12 15a3.5 3.5 0 0 0 3.5-3.5V6.5a3.5 3.5 0 1 0-7 0v5a3.5 3.5 0 0 0 3.5 3.5z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
                    <path d="M6 11a6 6 0 0 0 12 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M12 21v-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>
              <button id="viewer-mic-toggle" class="control-btn student-only" type="button" aria-label="Toggle microphone" aria-pressed="false" disabled data-tooltip="Mic">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <path d="M12 15a3.5 3.5 0 0 0 3.5-3.5V6.5a3.5 3.5 0 1 0-7 0v5a3.5 3.5 0 0 0 3.5 3.5z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
                    <path d="M6 11a6 6 0 0 0 12 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M4.5 4.5l15 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>
              <button id="viewer-camera-toggle" class="control-btn student-only" type="button" aria-label="Toggle camera" aria-pressed="false" data-tooltip="Camera" aria-haspopup="true" aria-expanded="false">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <rect x="4" y="6" width="11" height="12" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
                    <path d="M15 10l5-3v10l-5-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                    <path d="M4.5 4.5l15 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>

              <button id="live-camera-toggle" class="control-btn host-only" type="button" aria-label="Toggle camera" aria-pressed="true" data-tooltip="Camera" aria-haspopup="true" aria-expanded="false">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <rect x="4" y="6" width="11" height="12" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
                    <path d="M15 10l5-3v10l-5-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </button>
              <button id="toggle-chat" class="control-btn" type="button" aria-label="Chat" data-tooltip="Chat">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <path d="M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-4.5L8 20v-4H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
                      fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                  </svg>
                </span>
                <span class="control-badges">
                  <span id="chat-count-badge" class="control-badge hidden" aria-hidden="true">0</span>
                </span>
              </button>
              <button id="hand-raise-btn" class="control-btn student-only" type="button" aria-label="Raise hand" aria-pressed="false" data-tooltip="Raise hand">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <path d="M7 12V7.5a2 2 0 1 1 4 0V12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M11 12V5.5a2 2 0 1 1 4 0V12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M15 12V8.5a2 2 0 1 1 4 0V15a3 3 0 0 1-3 3h-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M6 14.5v1a4.5 4.5 0 0 0 4.5 4.5H13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>

      <!-- ✅ New Participants button directly in dock -->
              <button id="toggle-participants" class="control-btn" type="button" aria-label="Participants" data-tooltip="Participants">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <path d="M12 12a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 12 12z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
                    <path d="M6 20v-1a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
                <span class="control-badges">
                  <span id="participants-count-badge" class="control-badge hidden" aria-hidden="true">0</span>
                  <span id="participants-lobby-badge" class="control-badge subtle hidden" aria-hidden="true">0</span>
                </span>
              </button>

<button id="quick-record" class="control-btn host-only hidden" type="button" aria-pressed="false" aria-label="Start recording">
            <span class="icon">
              <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                <circle cx="12" cy="12" r="5" fill="currentColor"></circle>
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              </svg>
            </span>
       
          </button>

         
             
              <button id="screen-share" class="control-btn host-only" type="button" aria-label="Share screen" data-tooltip="Screen share">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <rect x="3.5" y="4.5" width="17" height="11.5" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
                    <path d="M12 16v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M8.5 20h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>
                <button id="end-btn" class="control-btn danger host-only" type="button" aria-label="End class" data-tooltip="End class">
        <span class="icon">
          <svg viewBox="0 0 24 24" role="presentation" focusable="false">
            <path d="M5 15a7 7 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <path d="M8 18l-2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M16 18l2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </button>
               
              <button id="control-more" class="control-btn" type="button" aria-label="More options" aria-controls="control-more-menu" aria-haspopup="true" aria-expanded="false" data-tooltip="More">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <circle cx="5" cy="12" r="1.8" fill="currentColor"></circle>
                    <circle cx="12" cy="12" r="1.8" fill="currentColor"></circle>
                    <circle cx="19" cy="12" r="1.8" fill="currentColor"></circle>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        </footer>
        <div id="control-more-menu" class="control-more-menu hidden" role="menu" aria-labelledby="control-more" aria-hidden="true">
          <div class="menu-grid">
