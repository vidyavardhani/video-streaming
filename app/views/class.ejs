                </svg>
              </span>
              <span class="text">Recording</span>
            </button> -->
            <!-- <button id="control-whiteboard" class="menu-btn host-only" type="button" role="menuitem" data-tooltip="Whiteboard">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <rect x="4" y="5" width="16" height="11" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
                  <path d="M8 19l2-3h4l2 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="text">Whiteboard</span>
            </button> -->
            <div class="menu-inline host-only" role="group" aria-label="Stage zoom controls">
              <button id="stage-zoom-out" class="menu-btn" type="button" role="menuitem" data-tooltip="Zoom out">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                    <path d="M8.5 12h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
                <span class="text">Zoom-out</span>
              </button>
              <button id="stage-zoom-in" class="menu-btn" type="button" role="menuitem" data-tooltip="Zoom in">
                <span class="icon">
                  <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                    <path d="M8.5 12h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                    <path d="M12 8.5v7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  </svg>
                </span>
                <span class="text">Zoom-in</span>
              </button>
            </div>
            <div id="tone-settings" class="menu-section host-only" role="group" aria-label="Host settings">
              <p class="menu-section-title">Host settings</p>
              <label class="tone-toggle" for="tone-toggle">
                <input type="checkbox" id="tone-toggle" class="tone-toggle-input" checked>
                <span class="tone-toggle-track" aria-hidden="true">
                  <span class="tone-toggle-thumb"></span>
                </span>
                <span class="tone-toggle-label">Notification tones</span>
              </label>
            </div>
            <button id="rejoin-btn" class="menu-btn student-only" type="button" role="menuitem" data-tooltip="Rejoin">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M11.5 5.5a6.5 6.5 0 1 1-6.33 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  <path d="M5 5.5h4v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text">Rejoin</span>
            </button>
            <button id="toggle-fullscreen" class="menu-btn" type="button" role="menuitem" data-tooltip="Fullscreen">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M21 8V5a2 2 0 0 0-2-2h-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M3 16v3a2 2 0 0 0 2 2h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M16 21h3a2 2 0 0 0 2-2v-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text" id="fullscreen-text">Fullscreen</span>
            </button>
            <button id="leave-btn" class="menu-btn" type="button" role="menuitem" data-tooltip="Leave">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M5 5h6a2 2 0 0 1 2 2v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  <path d="M13 14v3a2 2 0 0 1-2 2H5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                  <path d="M16 9l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M9 12h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="text">Leave</span>
            </button>
            <button id="end-btn" class="menu-btn danger host-only" type="button" role="menuitem" data-tooltip="End for all">
              <span class="icon">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M5 15a7 7 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                  <path d="M8 18l-2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M16 18l2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="text">End class</span>
            </button>
          </div>
        </div>
        <div id="live-toast" class="live-toast hidden" role="status" aria-live="polite"></div>
      </div>
    </section>

    <section id="rejoin-view" class="hidden">
      <div class="status-card">
        <div class="status-indicator reconnect"></div>
        <h2 id="rejoin-heading">Reconnect to your class</h2>
        <p id="rejoin-message">It looks like you left the class. Tap below to rejoin.</p>
        <button id="rejoin-screen-btn" class="primary">Rejoin</button>
      </div>
    </section>

    <section id="ended-view" class="hidden">
      <div class="status-card">
        <div class="status-indicator ended"></div>
        <h2>Host left, class ended</h2>
        <a href="/" class="secondary">Return to dashboard</a>
      </div>
    </section>
  </div>
  <div id="camera-menu" class="camera-menu hidden" role="menu" aria-hidden="true">
    <button id="camera-menu-toggle" type="button" role="menuitem">Turn camera off</button>
    <button id="camera-menu-switch" type="button" role="menuitem">Switch camera</button>
  </div>
  <div id="modal-layer" class="modal-layer hidden" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-card">
      <div class="modal-body">
        <h3 id="modal-title">Confirm</h3>
        <p id="modal-message"></p>
      </div>
      <div class="modal-actions">
        <button id="modal-secondary" type="button" class="ghost">Cancel</button>
        <button id="modal-primary" type="button" class="primary">OK</button>
      </div>
    </div>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/public/js/uploadQueue.js"></script>
  <script src="/public/js/class.js" defer></script>
  <script type="module" src="/public/js/meetingAutoJoin.js" defer></script>
</body>
</html>
